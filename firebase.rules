rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔒 DEFAULT: Alles verboten (Security First)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ✅ User-Daten: Nur der User selbst darf auf seine eigenen Daten zugreifen
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ✅ Projekte: Owner-Only Zugriff
    match /projects/{projectId} {
      // Erstellen: Jeder authentifizierte User kann Projekte erstellen
      allow create: if request.auth != null 
        && request.resource.data.ownerId == request.auth.uid;
      
      // Lesen: Nur der Owner
      allow read: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
      
      // Aktualisieren: Nur der Owner
      allow update: if request.auth != null 
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid; // Owner darf nicht geändert werden
      
      // Löschen: Nur der Owner
      allow delete: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
      
      // ✅ Analysen (Subcollection): Nur wenn Parent-Projekt dem User gehört
      match /analyses/{analysisId} {
        allow read, write: if request.auth != null 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      
      // ✅ Members (Subcollection): Nur wenn Parent-Projekt dem User gehört
      match /members/{memberId} {
        allow read: if request.auth != null 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        
        // Owner kann Members hinzufügen/entfernen
        allow write: if request.auth != null 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      
      // ✅ Pending Invites (Subcollection): Nur wenn Parent-Projekt dem User gehört
      match /pendingInvites/{inviteId} {
        allow read, write: if request.auth != null 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }
    
    // ✅ Waitlist: Jeder kann sich eintragen (auch ohne Auth für Coming Soon Seite)
    match /waitlist/{waitlistId} {
      // Erlaube Erstellen für alle (auch nicht-authentifizierte User für Coming Soon)
      allow create: if request.resource.data.email != null 
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*'); // Basis E-Mail Validierung
      // Erlaube Lesen für authentifizierte User (für syncUserProfile Query)
      // Die Query prüft where('email', '==', user.email), also nur eigene Einträge
      allow read: if request.auth != null;
    }
    
    // ✅ Project Invites: Einladungen für Projekte
    match /projectInvites/{inviteId} {
      // Erstellen: Nur Owner des Projekts kann Einladungen erstellen
      allow create: if request.auth != null 
        && request.resource.data.projectId != null
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid;
      
      // Lesen: Owner des Projekts ODER eingeladene Person
      // Für Queries: Erlaube für authentifizierte User (Query filtert bereits nach projectId/email)
      allow get: if request.auth != null && (
        // Owner des Projekts
        (resource.data.projectId != null && 
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid) ||
        // ODER eingeladene Person
        (resource.data.invitedEmail != null && 
         resource.data.invitedEmail.toLowerCase() == request.auth.token.email.toLowerCase())
      );
      
      // Collection-Queries: Erlaube für authentifizierte User (App filtert nach projectId/email)
      allow list: if request.auth != null;
      
      // Aktualisieren: Owner des Projekts ODER eingeladene Person (für accept/dismiss)
      allow update: if request.auth != null && (
        // Owner des Projekts
        (resource.data.projectId != null && 
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid) ||
        // ODER eingeladene Person (kann status, acceptedAt, dismissedAt, etc. ändern)
        (resource.data.invitedEmail != null && 
         resource.data.invitedEmail.toLowerCase() == request.auth.token.email.toLowerCase())
      );
      
      // Löschen: Nur Owner des Projekts
      allow delete: if request.auth != null 
        && resource.data.projectId != null
        && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid;
    }
    
    // ✅ System Stats (Daily Usage Counter): Nur Service Account kann schreiben
    // Diese Collection wird von der Netlify Function (mit Service Account) beschrieben
    match /system_stats/{date} {
      // Service Account (ohne request.auth) kann schreiben
      // Normale User können nur lesen (für Transparenz)
      allow read: if true; // Öffentlich lesbar (nur Count, keine sensiblen Daten)
      allow write: if request.auth == null; // Service Account (ohne Auth Token)
    }
  }
}
